{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/areymohit/myinnings.html",
      "destination": "/areymohit/myinnings",
      "permanent": true
    },
    {
      "source": "/areymohit/index.html",
      "destination": "/areymohit",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "destination": "https://mohitarjwani.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.mohitarjwani.com" }],
      "destination": "https://mohitarjwani.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_ds/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/support.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}